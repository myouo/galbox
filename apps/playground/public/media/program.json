  "globals": [
    {
      "id": "route",
      "kind": "string",
      "initial": {
        "kind": "string",
        "value": ""
      }
    }
  ],
  "functions": [
    {
      "id": "main",
      "entry": "wind:stage",
      "layout": 1,
      "params": [],
      "locals": [],
      "returns": "void",
      "code": [
        {
          "at": "wind:stage",
          "object": {
            "id": "background",
            "asset": "shore",
            "position": {
              "x": 0,
              "y": 0,
              "alpha": 1
            },
            "z": 0
          },
          "op": "stage.put"
        },
        {
          "at": "wind:silent",
          "task": "silent",
          "channel": "bgm",
          "to": {
            "kind": "f64",
            "op": "literal",
            "value": "0000000000000000"
          },
          "duration": {
            "kind": "i32",
            "op": "literal",
            "value": 1
          },
          "easing": "linear",
          "policy": "reject",
          "op": "audio.fade"
        },
        {
          "at": "wind:silent-wait",
          "group": "silent",
          "members": [
            "silent"
          ],
          "op": "task.join"
        },
        {
          "at": "wind:music",
          "task": "music",
          "asset": "bgm-long",
          "channel": "bgm",
          "gain": {
            "kind": "f64",
            "op": "literal",
            "value": "3fd3333333333333"
          },
          "loop": true,
          "loopStartMs": {
            "kind": "i32",
            "op": "literal",
            "value": 5000
          },
          "loopEndMs": {
            "kind": "i32",
            "op": "literal",
            "value": 10000
          },
          "restore": "replay",
          "op": "audio.track"
        },
        {
          "at": "wind:fade-in",
          "task": "fade-in",
          "channel": "bgm",
          "to": {
            "kind": "f64",
            "op": "literal",
            "value": "3ff0000000000000"
          },
          "duration": {
            "kind": "i32",
            "op": "literal",
            "value": 1000
          },
          "easing": "linear",
          "policy": "reject",
          "op": "audio.fade"
        },
        {
          "at": "wind:duck",
          "enabled": true,
          "level": {
            "kind": "f64",
            "op": "literal",
            "value": "3fd3333333333333"
          },
          "attackMs": {
            "kind": "i32",
            "op": "literal",
            "value": 120
          },
          "releaseMs": {
            "kind": "i32",
            "op": "literal",
            "value": 300
          },
          "op": "audio.duck"
        },
        {
          "at": "wind:voice",
          "task": "voice",
          "asset": "voice-opus",
          "channel": "voice",
          "gain": {
            "kind": "f64",
            "op": "literal",
            "value": "3fe6666666666666"
          },
          "restore": "replay",
          "loop": false,
          "loopStartMs": {
            "kind": "i32",
            "op": "literal",
            "value": 0
          },
          "loopEndMs": null,
          "op": "audio.track"
        },
        {
          "at": "wind:first",
          "textId": "wind.first",
          "revision": "zh-1",
          "speaker": "澪",
          "content": "灯亮以前，听一听海风吧。信纸上留下的每一个字，都想再说给你听一次。",
          "op": "text.page"
        },
        {
          "at": "wind:second-voice",
          "task": "voice",
          "asset": "voice-buffer",
          "channel": "voice",
          "gain": {
            "kind": "f64",
            "op": "literal",
            "value": "3fe4cccccccccccd"
          },
          "restore": "stop",
          "loop": false,
          "loopStartMs": {
            "kind": "i32",
            "op": "literal",
            "value": 0
          },
          "loopEndMs": null,
          "op": "audio.track"
        },
        {
          "at": "wind:second",
          "textId": "wind.second",
          "revision": "zh-1",
          "speaker": "澪",
          "content": "「还记得那封信吗？」澪问。我点点头，远处传来短短的一声回应。",
          "op": "text.page"
        },
        {
          "at": "wind:policy",
          "stopVoiceOnAdvance": false,
          "op": "audio.policy"
        },
        {
          "at": "wind:signal",
          "task": "signal",
          "asset": "signal-mp3",
          "channel": "sfx",
          "gain": {
            "kind": "f64",
            "op": "literal",
            "value": "3fd999999999999a"
          },
          "restore": "replay",
          "loop": false,
          "loopStartMs": {
            "kind": "i32",
            "op": "literal",
            "value": 0
          },
          "loopEndMs": null,
          "op": "audio.track"
        },
        {
          "at": "wind:signal-wait",
          "task": "signal",
          "op": "audio.wait"
        },
        {
          "at": "wind:third",
          "textId": "wind.third",
          "revision": "zh-1",
          "speaker": "澪",
          "content": "声音落下以后，海面恢复了安静。现在，该轮到我们回信了。",
          "op": "text.page"
        },
        {
          "at": "wind:fade-out",
          "task": "fade-out",
          "channel": "bgm",
          "to": {
            "kind": "f64",
            "op": "literal",
            "value": "0000000000000000"
          },
          "duration": {
            "kind": "i32",
            "op": "literal",
            "value": 1000
          },
          "easing": "linear",
          "policy": "reject",
          "op": "audio.fade"
        },
        {
          "at": "wind:fade-wait",
          "group": "fade",
          "members": [
            "fade-out"
          ],
          "op": "task.join"
        },
        {
          "at": "wind:stop",
          "channel": "bgm",
          "op": "audio.stop"
        },
        {
          "at": "wind:choice",
          "dest": "route",
          "options": [
            {
              "id": "send",
              "text": "把回信送向海上",
              "target": "wind:ending"
            },
            {
              "id": "keep",
              "text": "把回声留在灯下",
              "target": "wind:ending"
            }
          ],
          "op": "choice"
        },
        {
          "at": "wind:ending",
          "textId": "wind.ending",
          "revision": "zh-1",
          "speaker": "澪",
          "content": "海风替我们收好最后一句话。灯亮着，回信就不会走失。",
          "op": "text.page"
        },
        {
          "at": "wind:unlock",
          "key": "mediaComplete",
          "value": {
            "kind": "bool",
            "value": true
          },
          "op": "profile.set"
        },
        {
          "at": "wind:end",
          "op": "control.end"
        }
      ]
    }
  ]
}
