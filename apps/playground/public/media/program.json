      "sha256": "5a4823d9ca78fdd3f73823ed1d87366d1455457b1a767cbdbc4d9536790f3aba",
      "kind": "audio"
    },
    {
      "id": "voice-buffer",
      "path": "assets/voice-buffer.wav",
      "mime": "audio/wav",
      "sha256": "756a25bb86dc886696dec0863b30440c108899eaeec7034f6d4217c2517d6880",
