          "kind": "system",
          "family": "serif"
        },
        "fontSize": 22,
        "lineHeight": 1.8,
        "letterSpacing": 0.5,
        "color": "#D7EFF1",
        "speakerColor": "#FFD580",
        "background": "#123F50",
        "backgroundOpacity": 0.92,
        "borderColor": "#A2A99B",
        "borderWidth": 1,
        "padding": 24,
        "align": "left"
      }
    ],
    "windows": [
      {
        "id": "dialogue",
        "mode": "adv",
        "theme": "night",
        "rect": {
          "x": 48,
          "y": 500,
          "width": 1184,
          "height": 188
        },
        "z": 0,
        "visible": true,
        "maxEntries": 1
      },
      {
