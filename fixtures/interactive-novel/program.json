{
  "version": 1,
  "gameId": "lighthouse-interactive",
  "title": "燈塔來信 · 光中的選擇",
  "release": "interactive-1",
  "entry": "main",
  "capabilities": [
    "adv",
    "stage.linear",
    "audio.wav",
    "tasks.all",
    "profile",
    "values.extended",
    "interaction.timed",
    "expressions",
    "video.webm"
  ],
  "assets": [
    {
      "id": "shore",
      "path": "../assets/shore.svg",
      "mime": "image/svg+xml",
      "sha256": "50ced6a1205a9593b48688aea0cd345270f9f120fe52de0b8e1acbd0cbf37638",
      "kind": "image"
    },
    {
      "id": "beacon",
      "path": "assets/beacon-opus.webm",
      "mime": "video/webm",
      "sha256": "14917bed261f163a5c40484f290645d89b7836542cefef710bc7f138efc4873e",
      "kind": "video"
    },
    {
      "id": "vorbis",
      "path": "assets/beacon-vorbis.webm",
      "mime": "video/webm",
      "sha256": "1b230cb594dcb25116ac873ad71790bdc021a020ed47b0b9c2ebf3670c72e4b5",
      "kind": "video"
    },
    {
      "id": "silent",
      "path": "assets/beacon-silent.webm",
      "mime": "video/webm",
      "sha256": "d254416038588dd4494cf69c0077f613777d6520c021b71eb3a2f3915dc44a22",
      "kind": "video"
    }
  ],
  "globals": [
    {
      "id": "route",
      "kind": "string",
      "initial": {
        "kind": "string",
        "value": ""
      }
    }
  ],
  "functions": [
    {
      "id": "main",
      "entry": "signal:stage",
      "layout": 1,
      "params": [],
      "locals": [],
      "returns": "void",
      "code": [
        {
          "at": "signal:stage",
          "object": {
            "id": "background",
            "asset": "shore",
            "position": {
              "x": 0,
              "y": 0,
              "alpha": 1
            },
            "z": 0
          },
          "op": "stage.put"
        },
        {
          "at": "signal:welcome",
          "textId": "signal.welcome",
          "revision": "zh-1",
          "speaker": "澪",
          "content": "燈光會替我們回答嗎？先看看遠方傳來的影像吧。",
          "op": "text.page"
        },
        {
          "at": "signal:movie",
          "task": "opening",
          "asset": "beacon",
          "rect": {
            "x": 0,
            "y": 0,
            "width": 1280,
            "height": 720
          },
          "gain": 0.35,
          "skippable": true,
          "restore": "replay",
          "op": "video.play"
        },
        {
          "at": "signal:after",
          "textId": "signal.after",
          "revision": "zh-1",
          "speaker": "澪",
          "content": "光影停下後，兩個回信的位置出現在海面上。你可以點選，也可以用鍵盤選擇。",
          "op": "text.page"
        },
        {
          "at": "signal:hotspot",
          "dest": "route",
          "label": "選擇回信的方向",
          "options": [
            {
              "id": "shore",
              "label": "點亮海岸",
              "target": "signal:shore",
              "rect": {
                "x": 180,
                "y": 280,
                "width": 300,
                "height": 140
              },
              "enabled": {
                "kind": "bool",
                "op": "literal",
                "value": true
              }
            },
            {
              "id": "tower",
              "label": "點亮燈塔",
              "target": "signal:tower",
              "rect": {
                "x": 800,
                "y": 280,
                "width": 300,
                "height": 140
              },
              "enabled": {
                "kind": "bool",
                "op": "literal",
                "value": true
              }
            },
            {
              "id": "sealed",
              "label": "尚未開啟",
              "target": "signal:tower",
              "enabled": {
                "kind": "bool",
                "op": "literal",
                "value": false
              },
              "rect": {
                "x": 520,
                "y": 280,
                "width": 240,
                "height": 140
              }
            }
          ],
          "deadlineMs": null,
          "timeout": null,
          "op": "interaction.prompt"
        },
        {
          "at": "signal:shore",
          "textId": "signal.shore",
          "revision": "zh-1",
          "speaker": "澪",
          "content": "我們把海岸的燈點亮，讓遠方的人看見歸路。",
          "op": "text.page"
        },
        {
          "at": "signal:shore-join",
          "target": "signal:timed",
          "op": "control.jump"
        },
        {
          "at": "signal:tower",
          "textId": "signal.tower",
          "revision": "zh-1",
          "speaker": "澪",
          "content": "我們守住燈塔的光，等待下一次回聲。",
          "op": "text.page"
        },
        {
          "at": "signal:tower-join",
          "target": "signal:timed",
          "op": "control.jump"
        },
        {
          "at": "signal:timed",
          "dest": "route",
          "label": "潮聲到來以前，要把信寄出去嗎？",
          "options": [
            {
              "id": "send",
              "label": "現在寄出",
              "target": "signal:send",
              "enabled": {
                "kind": "bool",
                "op": "literal",
                "value": true
              }
            },
            {
              "id": "keep",
              "label": "再等一會",
              "target": "signal:wait",
              "enabled": {
                "kind": "bool",
                "op": "literal",
                "value": true
              }
            }
          ],
          "deadlineMs": {
            "kind": "i32",
            "op": "literal",
            "value": 6000
          },
          "timeout": {
            "id": "tide",
            "target": "signal:timeout"
          },
          "op": "interaction.prompt"
        },
        {
          "at": "signal:send",
          "textId": "signal.send",
          "revision": "zh-1",
          "speaker": "澪",
          "content": "你趕在潮聲之前寄出了信。這一次，回聲會知道我們的名字。",
          "op": "text.page"
        },
        {
          "at": "signal:send-join",
          "target": "signal:final-movie",
          "op": "control.jump"
        },
        {
          "at": "signal:wait",
          "textId": "signal.wait",
          "revision": "zh-1",
          "speaker": "澪",
          "content": "你把信留在燈下，讓每一句話再多停留片刻。",
          "op": "text.page"
        },
        {
          "at": "signal:wait-join",
          "target": "signal:final-movie",
          "op": "control.jump"
        },
        {
          "at": "signal:timeout",
          "textId": "signal.timeout",
          "revision": "zh-1",
          "speaker": "澪",
          "content": "潮聲先一步來了。澪輕輕收好信紙，約定明天再來。",
          "op": "text.page"
        },
        {
          "at": "signal:final-movie",
          "task": "final",
          "asset": "silent",
          "rect": {
            "x": 0,
            "y": 0,
            "width": 1280,
            "height": 720
          },
          "gain": 1,
          "skippable": false,
          "restore": "forbid",
          "op": "video.play"
        },
        {
          "at": "signal:ending",
          "textId": "signal.ending",
          "revision": "zh-1",
          "speaker": "澪",
          "content": "不論回信何時出發，燈始終亮著。",
          "op": "text.page"
        },
        {
          "at": "signal:unlock",
          "key": "interactiveComplete",
          "value": {
            "kind": "bool",
            "value": true
          },
          "op": "profile.set"
        },
        {
          "at": "signal:end",
          "op": "control.end"
        }
      ]
    }
  ]
}
