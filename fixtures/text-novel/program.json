          "op": "text.rich"
        },
        {
          "at": "paper:light",
          "textId": "paper.light",
          "revision": "zh-1",
          "speaker": {
            "kind": "string",
            "op": "literal",
            "value": "澪"
          },
          "runs": [
            {
              "kind": "text",
              "content": {
                "kind": "string",
                "op": "literal",
                "value": "「先别急着翻页。」"
