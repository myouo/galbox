              "target": "paper:ending"
            },
            {
              "id": "keep",
              "text": "把信留在灯下",
              "target": "paper:ending"
            }
          ],
          "op": "choice"
        },
        {
          "at": "paper:ending",
          "textId": "paper.ending",
          "revision": "zh-1",
          "speaker": {
            "kind": "string",
            "op": "literal",
            "value": "灯塔来信"
          },
          "runs": [
            {
              "kind": "text",
              "content": {
                "kind": "string",
                "op": "if",
                "condition": {
                  "kind": "bool",
                  "op": "eq",
                  "operandKind": "string",
                  "left": {
                    "kind": "string",
                    "op": "slot",
                    "id": "route"
                  },
                  "right": {
                    "kind": "string",
                    "op": "literal",
                    "value": "send"
                  }
                },
                "yes": {
                  "kind": "string",
                  "op": "literal",
                  "value": "我把回信折好，交给下一班靠岸的船。"
                },
                "no": {
                  "kind": "string",
                  "op": "literal",
                  "value": "我把信压在值班簿里，等下一位守灯的人。"
                }
              }
            },
            {
              "kind": "break"
            },
            {
              "kind": "ruby",
              "content": {
                "kind": "string",
                "op": "literal",
                "value": "明日"
              },
              "reading": {
                "kind": "string",
                "op": "literal",
                "value": "あした"
              },
              "style": {
                "bold": true,
                "color": "#FFD580"
              }
            },
            {
              "kind": "text",
              "content": {
                "kind": "string",
                "op": "literal",
                "value": "的光，会找到它该去的地方。"
              },
              "style": {
                "effect": {
                  "kind": "fade",
                  "duration": 300
                }
              }
            }
          ],
          "op": "text.rich"
        },
        {
          "at": "paper:unlock",
          "key": "paperComplete",
          "value": {
            "kind": "bool",
            "value": true
          },
          "op": "profile.set"
        },
        {
          "at": "paper:end",
          "op": "control.end"
        }
      ]
