              "kind": "text",
              "content": {
                "kind": "string",
                "op": "literal",
                "value": "把海风也写进了信里。"
              }
            },
            {
              "kind": "break"
            },
            {
              "kind": "text",
              "content": {
                "kind": "string",
                "op": "literal",
                "value": "信末画着一家人👨‍👩‍👧‍👦，还有一颗星。"
              },
              "style": {
                "underline": true
              }
            }
