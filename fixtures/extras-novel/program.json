  "functions": [
    {
      "id": "main",
      "entry": "main:stage",
      "layout": 1,
      "params": [],
      "locals": [],
      "returns": "void",
      "code": [
        {
          "at": "main:stage",
          "object": {
            "id": "background",
            "asset": "shore",
            "position": {
              "x": 0,
              "y": 0,
              "alpha": 1
            },
            "z": 0
          },
          "op": "stage.put"
        },
        {
          "at": "main:music",
          "task": "bgm",
          "asset": "bgm-long",
          "channel": "bgm",
          "gain": {
            "kind": "f64",
            "op": "literal",
            "value": "3fb999999999999a"
          },
          "loop": true,
          "restore": "replay",
          "loopStartMs": {
            "kind": "i32",
            "op": "literal",
            "value": 0
          },
          "loopEndMs": null,
          "op": "audio.track"
        },
        {
          "at": "main:token",
          "dest": "token",
          "value": {
            "literal": {
              "kind": "string",
              "value": "main-run"
            }
          },
          "op": "value.set"
        },
        {
          "at": "main:welcome",
          "textId": "collection.welcome",
          "revision": "zh-1",
          "speaker": "澪",
          "content": "收藏室里装着灯塔收到的声音、风景和故事。翻过这一页，再看看菜单里新亮起的收藏。",
          "op": "text.page"
        },
        {
          "at": "main:collect",
          "key": "collected",
          "value": {
            "kind": "bool",
            "value": true
          },
          "op": "profile.set"
        },
        {
          "at": "main:signal",
          "entry": "signal",
          "op": "extras.unlock"
        },
        {
          "at": "main:reading",
          "textId": "collection.reading",
          "revision": "zh-1",
          "speaker": "澪",
          "content": "你可以打开CG、试听音乐，或走进信里的小场景。关闭鉴赏后，我们仍在这里继续读信。",
          "op": "text.page"
        },
        {
          "at": "main:reset",
          "key": "collected",
          "value": {
            "kind": "bool",
            "value": false
          },
          "op": "profile.set"
        },
        {
          "at": "main:closing",
          "textId": "collection.closing",
          "revision": "zh-1",
          "speaker": "澪",
          "content": "收集标记已经复位，但风景与成就仍会保留。只有回放里点亮的那盏灯，不会偷偷进入主线收藏。",
          "op": "text.page"
        },
        {
          "at": "main:end",
          "op": "control.end"
        }
      ]
    },
    {
      "id": "memory",
      "entry": "memory:scene",
      "layout": 1,
      "params": [],
      "locals": [
        {
          "id": "local",
          "kind": "i32",
          "initial": {
            "kind": "i32",
            "value": 9
          }
        }
      ],
      "returns": "void",
      "code": [
        {
          "at": "memory:scene",
          "entry": "memory",
          "op": "extras.scene"
        },
        {
          "at": "memory:stage",
          "object": {
            "id": "background",
            "asset": "tower",
            "position": {
              "x": 0,
              "y": 0,
              "alpha": 1
            },
            "z": 0
          },
          "op": "stage.put"
        },
        {
          "at": "memory:token",
          "dest": "token",
          "value": {
            "literal": {
              "kind": "string",
              "value": "replay-run"
            }
          },
          "op": "value.set"
        },
        {
          "at": "memory:roll",
          "dest": "roll",
          "min": {
            "kind": "i32",
            "op": "literal",
            "value": 1
          },
          "max": {
            "kind": "i32",
            "op": "literal",
            "value": 99
          },
          "op": "random.i32"
        },
        {
          "at": "memory:leak",
          "key": "replayLeak",
          "value": {
            "kind": "bool",
            "value": true
          },
          "op": "profile.set"
        },
        {
          "at": "memory:secret",
          "entry": "secret",
          "op": "extras.unlock"
        },
        {
          "at": "memory:voice",
          "task": "voice",
          "asset": "voice-opus",
          "channel": "voice",
          "gain": {
            "kind": "f64",
            "op": "literal",
            "value": "3fd999999999999a"
          },
          "restore": "replay",
          "loop": false,
          "loopStartMs": {
            "kind": "i32",
            "op": "literal",
            "value": 0
          },
          "loopEndMs": null,
          "op": "audio.track"
        },
        {
          "at": "memory:first",
          "textId": "collection.memory",
          "revision": "zh-1",
          "speaker": "澪",
          "content": "这是收藏室里的独立回放。这里的变量、已读和新收藏都只属于这一次回放。",
          "op": "text.page"
        },
        {
          "at": "memory:choice",
          "dest": "answer",
          "options": [
            {
              "id": "left",
              "text": "把回声留在窗边",
              "target": "memory:ending"
            },
            {
              "id": "right",
              "text": "把回声写在纸上",
              "target": "memory:ending"
            }
          ],
          "op": "choice"
        },
        {
          "at": "memory:ending",
          "key": "replayEnding",
          "value": {
            "kind": "bool",
            "value": true
          },
          "op": "profile.set"
        },
        {
          "at": "memory:last",
          "textId": "collection.memory-end",
          "revision": "zh-1",
          "speaker": "澪",
          "content": "小场景结束了。关闭鉴赏，就能回到原来那封尚未读完的信。",
          "op": "text.page"
        },
        {
          "at": "memory:return",
          "op": "control.return"
        }
      ]
    }
  ],
