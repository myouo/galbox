      "initial": {
        "kind": "string",
        "value": "none"
      }
    },
    {
      "id": "author",
      "kind": "string",
      "initial": {
        "kind": "string",
        "value": "未署名"
      }
    },
    {
      "id": "lampOn",
      "kind": "bool",
      "initial": {
        "kind": "bool",
        "value": false
      }
    },
    {
      "id": "power",
      "kind": "i32",
      "initial": {
        "kind": "i32",
        "value": 0
      }
    }
  ],
  "functions": [
    {
      "id": "main",
      "entry": "main:stage",
      "layout": 1,
      "params": [],
      "locals": [],
      "returns": "void",
      "code": [
        {
          "at": "main:stage",
          "object": {
            "id": "background",
            "asset": "shore",
            "position": {
              "x": 0,
              "y": 0,
              "alpha": 1
            },
            "z": 0
          },
          "op": "stage.put"
        },
        {
          "at": "main:intro",
          "textId": "controls.intro",
          "revision": "zh-1",
          "speaker": "澪",
          "content": "今天的回信由你来署名。下一页会打开值班面板，可以在编辑中保存，刷新后继续。",
          "op": "text.page"
        },
        {
          "at": "main:clear",
          "op": "text.clear"
        },
        {
          "at": "main:form",
          "function": "form",
          "args": [],
          "op": "control.call"
        },
        {
          "at": "main:summary",
          "textId": "controls.summary",
          "revision": "zh-1",
          "speaker": {
            "kind": "string",
            "op": "literal",
            "value": "澪"
          },
          "content": {
            "kind": "string",
            "op": "concat",
            "parts": [
              {
                "kind": "string",
                "op": "literal",
                "value": "收到署名「"
              },
              {
                "kind": "string",
                "op": "slot",
                "id": "author"
              },
              {
                "kind": "string",
                "op": "literal",
                "value": "」，灯光 "
              },
              {
                "kind": "string",
                "op": "format",
                "operandKind": "i32",
                "value": {
                  "kind": "i32",
                  "op": "slot",
                  "id": "power"
                }
              },
              {
                "kind": "string",
                "op": "literal",
                "value": "，点亮 "
              },
              {
                "kind": "string",
                "op": "format",
                "operandKind": "bool",
                "value": {
                  "kind": "bool",
                  "op": "slot",
                  "id": "lampOn"
                }
              },
              {
                "kind": "string",
                "op": "literal",
                "value": "。这是剧本读取控件提交值后的正文。"
              }
            ]
          },
          "op": "text.template"
        },
        {
          "at": "main:end",
          "op": "control.end"
        }
      ]
    },
    {
      "id": "form",
      "entry": "form:show",
      "layout": 1,
      "params": [],
      "locals": [
        {
          "id": "draft",
          "kind": "string",
          "initial": {
            "kind": "string",
            "value": ""
          }
        }
      ],
      "returns": "void",
      "code": [
        {
          "at": "form:show",
          "screen": "panel",
          "op": "ui.show"
        },
        {
          "at": "form:title",
          "screen": "panel",
          "control": "heading",
          "value": {
            "kind": "string",
            "op": "literal",
            "value": "请填写今晚的值班记录"
          },
          "op": "ui.text"
        },
        {
          "at": "form:name",
          "screen": "panel",
          "control": "name",
          "value": {
            "kind": "string",
            "op": "literal",
            "value": "灯塔旅人"
          },
          "op": "ui.input"
        },
        {
          "at": "form:power",
          "screen": "panel",
          "control": "power",
          "value": {
            "kind": "i32",
            "op": "literal",
            "value": 35
          },
          "op": "ui.range"
        },
        {
          "at": "form:locked",
          "screen": "panel",
          "control": "locked",
          "value": {
            "kind": "bool",
            "op": "literal",
            "value": false
          },
          "op": "ui.enabled"
        },
        {
          "at": "form:hidden",
          "screen": "panel",
          "control": "hidden",
          "value": {
            "kind": "bool",
            "op": "literal",
            "value": false
          },
          "op": "ui.visible"
        },
        {
          "at": "form:wait",
          "screen": "panel",
          "dest": "button",
          "buttons": [
            {
              "control": "submit",
              "target": "form:save"
            },
            {
              "control": "cancel",
              "target": "form:cancel"
            }
          ],
          "fields": [
            {
              "control": "name",
              "dest": "draft"
            },
            {
              "control": "lampOn",
              "dest": "lampOn"
            },
            {
              "control": "power",
              "dest": "power"
            }
          ],
          "op": "ui.wait"
        },
        {
          "at": "form:save",
          "dest": "author",
          "value": {
            "expression": {
              "kind": "string",
              "op": "slot",
              "id": "draft"
            }
          },
          "op": "value.set"
        },
        {
          "at": "form:profile",
          "key": "lastAuthor",
          "value": {
            "kind": "string",
            "op": "slot",
            "id": "author"
          },
          "op": "profile.expression"
        },
        {
          "at": "form:done",
          "target": "form:hide",
          "op": "control.jump"
        },
        {
          "at": "form:cancel",
          "dest": "author",
          "value": {
            "literal": {
              "kind": "string",
              "value": "暂不值班"
            }
          },
          "op": "value.set"
        },
        {
          "at": "form:hide",
          "op": "ui.hide"
        },
        {
          "at": "form:return",
          "op": "control.return"
        }
      ]
    }
  ],
