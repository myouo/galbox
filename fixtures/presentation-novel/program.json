              "kind": "string",
              "value": "main-run"
            }
          },
          "op": "value.set"
        },
        {
          "at": "main:welcome",
          "textId": "collection.welcome",
          "revision": "zh-1",
          "speaker": "澪",
          "content": "收藏室里装着灯塔收到的声音、风景和故事。翻过这一页，再看看菜单里新亮起的收藏。",
          "op": "text.page"
        },
        {
          "at": "main:collect",
          "key": "collected",
          "value": {
            "kind": "bool",
            "value": true
          },
          "op": "profile.set"
        },
        {
          "at": "main:signal",
          "entry": "signal",
          "op": "extras.unlock"
        },
        {
          "at": "main:reading",
          "textId": "collection.reading",
          "revision": "zh-1",
          "speaker": "澪",
          "content": "你可以打开CG、试听音乐，或走进信里的小场景。关闭鉴赏后，我们仍在这里继续读信。",
          "op": "text.page"
        },
        {
          "at": "main:reset",
          "key": "collected",
          "value": {
            "kind": "bool",
            "value": false
          },
          "op": "profile.set"
        },
        {
          "at": "main:closing",
          "textId": "collection.closing",
          "revision": "zh-1",
          "speaker": "澪",
          "content": "收集标记已经复位，但风景与成就仍会保留。只有回放里点亮的那盏灯，不会偷偷进入主线收藏。",
          "op": "text.page"
        },
        {
          "at": "main:end",
          "op": "control.end"
        }
      ]
    },
